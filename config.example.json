{
  "backend": "openai",
  "model": "your-model-name",
  "source": "en",
  "target": "es",
  "base_url": "https://api.openai.com/v1",
  "api_key_env": "OPENAI_API_KEY",
  "output_dir": "~/dragoman",
  "translate_chunk": 100,
  "review_chunk": 60,
  "parallel": 3,
  "satir_sinir": 42,
  "reading_speed_threshold": 20,
  "timeout_seconds": 900,
  "max_quota_wait_seconds": 3600,
  "meaning_gate": true,
  "target_cps": 17,
  "max_extension_seconds": 1.5,
  "human_check": true,
  "human_scoring": false,
  "human_threshold": 8.5,
  "level_report": true,
  "learner_profile": "intermediate learner of the source language",
  "content_warnings": true,
  "break_chapters": true,
  "honorific_comments": false,
  "translator_notes": false,
  "fallback_fonts": [],
  "share_prompt": true,
  "guide_extra": []
}
